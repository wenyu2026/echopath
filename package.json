{
  "name": "xuejun-hackathon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "学军黑客松 2026 · 赛道一 Echo · 来路 EchoPath",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "server": "node --env-file=.env server/api.ts",
    "test": "node --test \"server/tests/*.test.ts\"",
    "validate:data": "node scripts/validate-data.mjs",
    "build:cache": "node scripts/build-demo-cache.mjs",
    "refresh:cache": "node scripts/build-demo-cache.mjs --from-api",
    "preflight": "node scripts/preflight.mjs",
    "start": "node scripts/start-demo.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
