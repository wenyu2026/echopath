.env
.env.*
!.env.example
*.key
*.pem
*.p12
secrets.json
credentials.json

# ============================================
# 依赖目录（用共享 node_modules 策略，不入库）
# ============================================
node_modules/
.pnpm-store/
venv/
.venv/
__pycache__/
*.pyc

# ============================================
# 构建产物
# ============================================
dist/
build/
out/
.next/
*.tsbuildinfo

# ============================================
# 编辑器与系统
# ============================================
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# ============================================
# 日志与临时文件
# ============================================
*.log
npm-debug.log*
pnpm-debug.log*
.cache/
tmp/
temp/

# 断网兜底测试的临时目录（自动生成、自动清理）
.offline-test-*/

# 其他 agent 工具的临时目录
.zcode/

# 上传前检查用的临时工作目录（解压包 + 检查报告，不入库）
.incoming-echopath/
