; ============================================
; 学军黑客松 · 项目级 npm 配置
; 作用范围：本目录及其所有子目录（npm / pnpm 都会读取）
; 为什么：赛场实测同一批 83 个包（全新空缓存、同一时刻对比）
;         npmmirror 188 秒 / 华为云 110 秒 / 腾讯云仅 35 秒
;         npmmirror 的大文件下载不算慢，但元数据接口很慢，装包必卡
; 队友克隆仓库后自动生效，无需各自改全局配置
; ============================================

registry=https://mirrors.cloud.tencent.com/npm/

; 网络慢，把超时放宽，避免大包中途失败重来
fetch-timeout=120000
fetch-retries=3
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=120000
maxsockets=8

; 关掉拖慢安装的审计和赞助提示
audit=false
fund=false
