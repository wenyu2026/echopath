# ============================================
# 环境变量模板
# ============================================
# 用法：
#   1. 复制这个文件为 .env
#        copy .env.example .env      (Windows)
#        cp .env.example .env        (Mac/Linux)
#   2. 把下面的值换成真实的
#   3. .env 已被 .gitignore 挡住，绝不会进仓库
# ============================================

# TokenDance API Key —— 所有 AI 功能都靠它
# 获取方式：https://tokendance.space/keys （创建后只显示一次，立刻保存）
# ⚠️ 向队长索取，或用自己的账号创建
TOKENDANCE_API_KEY=

# 后端服务端口（#9 后端任务用）
PORT=3000

# 前端调后端的地址（#8 前端任务用，一般不用改）
VITE_API_BASE=http://localhost:3000
