# ============================================
# 环境变量模板
# ============================================
# 用法：
#   1. 复制这个文件为 .env
#        copy .env.example .env      (Windows)
#        cp .env.example .env        (Mac/Linux)
#   2. 把下面的值换成真实的
#   3. .env 已被 .gitignore 挡住，绝不会进仓库
# ============================================

# TokenDance API Key —— 所有 AI 功能都靠它
# 获取方式：https://tokendance.space/keys （创建后只显示一次，立刻保存）
# ⚠️ 向队长索取，或用自己的账号创建
TOKENDANCE_API_KEY=

# 处境解析模型（可选，默认 deepseek-v4.1-flash，实测 2.3s）
# 回退示例：SITUATION_MODEL=glm-5 （需配合 gateway 的 reasoning_effort:none，约 6.0s）
# 实测不可用的模型别再试：glm-5.3-flashx / glm-5.3 / glm-4.5-air / step-3.7-flash /
#   qwen3.5-flash / minimax-m3（详见 README「技术要点」）
SITUATION_MODEL=

# 后端服务端口
# ⚠️ 必须与前端的转发目标一致。start-backend.bat / frontend\start-frontend.bat
#    都按 3100 配置，改这里就要同步改那两个 bat（三处一致）。
#    注意：本机 3000 端口常被其他服务占用，别用 3000。
PORT=3100

# 前端调后端的地址（一般不用改）
VITE_API_BASE=http://localhost:3100

# ============================================
# 以下全部是**可选覆盖**，不填就用默认值
# ============================================
# ⚠️ 这些不是必须的 —— 留空/不写都能跑。列在这里是为了让人知道它们存在。

# TokenDance 网关地址（默认 https://tokendance.space/gateway/v1）
# 换网关时才需要改
# TOKENDANCE_BASE=

# 各环节用的模型（默认都是 deepseek-v4.1-flash，实测 1.6-2.5s）
# 分开列是为了能单独调某一个环节而不影响其他
# INTERVIEW_MODEL=      # 访谈：决定下一个问什么
# EXTRACT_MODEL=        # 访谈：从回答里抽结构化信息
# SUMMARY_MODEL=        # 访谈：把收获讲回给用户
# FACTOR_MODEL=         # 把自然语言映射到封闭词表的根因素
# MECHANISM_MODEL=      # 离线打机制标签（npm run tag:mechanisms）
# MECHANISM_CONCURRENCY=4   # 打标签的并发数

# 前端冒烟测试用（npm run smoke / smoke:offline）
# CHROME_PATH=          # 指定浏览器路径（找不到 Chrome/Edge 时才需要）
# SMOKE_BASE=           # 被测前端地址（默认 http://localhost:5173）

# 只给测试用：覆盖案例数据路径
# EPISODES_PATH=
